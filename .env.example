ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=replace-with-a-local-password
APP_DB_PASSWORD=replace-with-a-different-url-safe-local-password

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
WORKER_POLL_INTERVAL_SECONDS=5
JOB_VISIBILITY_TIMEOUT_SECONDS=900
JOB_BACKOFF_BASE_SECONDS=10
JOB_BACKOFF_MAX_SECONDS=3600

LLM_DAILY_COST_CAP_USD=1.00
LLM_PROVIDER=fake
LLM_MODEL_FAST=fake-fast
LLM_MODEL_REASONING=fake-reasoning
LLM_MODEL_PRICES={"fake-fast":{"input_usd_per_mtok":"1","output_usd_per_mtok":"5"},"fake-reasoning":{"input_usd_per_mtok":"1","output_usd_per_mtok":"5"}}
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_API_KEY=

# Anthropic placeholders, checked against the public docs on 2026-10-02. Prices are assumptions
# until verified against your own billing. To use them, replace the five LLM_* lines above and
# set the key:
# LLM_PROVIDER=anthropic
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_MODEL_REASONING=claude-sonnet-5-5
# LLM_MODEL_PRICES={"claude-haiku-4-5-20251001":{"input_usd_per_mtok":"1","output_usd_per_mtok":"5"},"claude-sonnet-5-5":{"input_usd_per_mtok":"2","output_usd_per_mtok":"10"}}
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

RESUME_MAX_BYTES=5242880
RESUME_MAX_PAGES=10
PARSE_TIMEOUT_SECONDS=30
EXTRACTED_TEXT_MAX_CHARS=200000

JD_MIN_CHARS=200
JD_MAX_CHARS=50000
JD_EXTRACTION_MAX_OUTPUT_TOKENS=6000

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_HOURS=168
SESSION_ABSOLUTE_TIMEOUT_HOURS=720
SESSION_COOKIE_SECURE=true
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
